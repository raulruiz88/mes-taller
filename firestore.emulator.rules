rules_version = '2';
// REGLAS PERMISIVAS — SOLO PARA EMULADOR LOCAL DE DESARROLLO
// Estas reglas permiten todo para facilitar el seed de datos demo.
// NO usar en producción. El archivo firestore.rules tiene las reglas reales.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
